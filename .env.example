# Gemini key. Empty = local MIRA/TrashNet only.
GEMINI_API_KEY=
# At most two models and 6 requests per minute.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_RPM=6
# Session signature and classroom codes. Required on Render.
ECOSCAN_SECRET=
# Frontend origin. * in development.
FRONTEND_URL=*
# Supabase Postgres. If missing, local SQLite is used.
DATABASE_URL=
PORT=8000
